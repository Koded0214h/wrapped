VITE_TELEMETRY=off
PRIVACY_COPY_MODE=ai-facts
VITE_AI_MODE=facts-only
VITE_AI_PLANNER=off
# free = everything open, mock = pretend checkout (local only!), bachs = real checkout for premium styles
VITE_PAYMENT_MODE=free
PORT=8787
# Set to true only behind your own proxy that appends X-Forwarded-For. Without it, every visitor behind a proxy shares one rate limit.
TRUST_PROXY=false
AI_DAILY_PLAN_LIMIT=200
AI_DAILY_COST_CAP_USD=20
AI_MAX_CHAT_CHARS=4000000
AI_MAX_CONCURRENT=4
MAX_RECOVERIES_PER_REFERENCE=5
OPENAI_TIMEOUT_MS=120000
ADMIN_SECRET=change-me
DATABASE_PATH=./data/chat-wrapped.sqlite
CAP_NGN=500000
# https://docs.bachs.io. An sk_sandbox_ key uses the sandbox automatically. Never prefix these with VITE_.
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# Where Bachs sends buyers back. Must be a public URL: Bachs refuses localhost.
PAYMENT_RETURN_URL=https://chat-wrapped.kodedlabs.com/
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_INPUT_USD_PER_MILLION=4
OPENAI_PLANNER_INPUT_CHAR_CAP=120000
OPENAI_OUTPUT_USD_PER_MILLION=20
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_WHATSAPP=+2340000000000
USD_CHECKOUT_ENABLED=false
MID_LAUNCH_DATE=2026-12-15
